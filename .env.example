# Copie para .env e preencha. Nunca versione o .env.

# Provedor de LLM: groq | gemini | fake (fake = respostas determinísticas, sem rede; usado nos testes)
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Banco local (documentos, chunks e feedback)
DATABASE_PATH=var/lion.sqlite3
