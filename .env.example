# Copie para .env e preencha. Nunca versione o .env.
# Variável vazia ou ausente usa o padrão; valor inválido impede a API de subir (ConfigError).

# Provedor de LLM: groq | fake (fake = respostas determinísticas, sem rede; usado nos testes)
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=20

# Banco local (documentos, chunks, respostas e feedback). No Docker: /data/lion.sqlite3
DATABASE_PATH=var/lion.sqlite3

# Busca: trechos usados por resposta quando a pergunta não informa top_k (1 a 10)
DEFAULT_TOP_K=4
# Ingestão: tamanho máximo de cada trecho, em caracteres (100 a 4000)
CHUNK_MAX_CHARS=800
